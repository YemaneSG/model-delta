# Public image — synthesized models only. Downloads from HuggingFace Hub at startup.
# Real enterprise weights must NEVER be in this image.
# Build context: repo root (fly.toml default)

FROM python:3.12-slim

WORKDIR /app

COPY showcase-api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY showcase-api/ .

RUN chmod +x startup.sh

ENV MODEL_ROOT=/app/models
ENV APP_ENV=public

EXPOSE 8000
CMD ["./startup.sh"]
