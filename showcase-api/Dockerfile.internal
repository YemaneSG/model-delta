# Internal image — runs from laptop with real models volume-mounted at MODEL_ROOT.
# NOT for public deployment. Never push to a public registry.
#
# Build:   docker build -f Dockerfile.internal -t model-delta-api:internal .
# Run:     see docker-compose.yml at the repo root

FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .

# Install CPU-only PyTorch first to avoid pulling the ~2GB CUDA wheel
RUN pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

# Install the rest; torch is already satisfied so pip won't reinstall it
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV APP_ENV=internal
# MODEL_ROOT must be provided at runtime via -e MODEL_ROOT=/models
# and the model directory must be volume-mounted at /models

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
