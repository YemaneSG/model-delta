# Internal image — runs from laptop with real models mounted at MODEL_ROOT.
# NOT for public deployment. Never push to a public registry.
# Usage: docker build -f Dockerfile.internal -t model-delta-api:internal .
#        docker run -e MODEL_ROOT=/models -v /path/to/ml_pipeline:/models model-delta-api:internal

FROM python:3.12-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

ENV APP_ENV=internal
# MODEL_ROOT must be provided at runtime via -e MODEL_ROOT=... (volume mount)

EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
